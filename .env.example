# Settings read by setup-script.sh. Copy these lines into your environment's setup script
# (the loader in README.md), above the line that runs setup-script.sh, and fill in the values.
#
# Why not the environment's "Environment variables" box? Cloud setup scripts can't read the
# environment's saved variables, so the values must be set in the setup script itself.
# All four are required; the script stops before installing anything if one is blank.

FRAPPE_BENCH_DIR="/home/user/frappe-bench"  # bench directory (under /home/user so the Claude app can open its files)
FRAPPE_SITE="myproject.localhost"           # default site name
FRAPPE_DB_ROOT_PASSWORD="change-me"         # MariaDB root password (dev only; don't reuse real ones)
FRAPPE_ADMIN_PASSWORD="change-me"           # site Administrator password (dev only)
